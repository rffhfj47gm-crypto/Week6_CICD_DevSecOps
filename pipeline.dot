digraph pipeline { graph [rankdir=LR, bgcolor="white", nodesep=.35, ranksep=.42, fontname="DejaVu Sans"]; node [shape=box,style="rounded,filled",fillcolor="#EAF2FB",color="#3B6388",fontname="DejaVu Sans",fontsize=10]; edge [color="#3B6388",arrowsize=.7]; start [label="Git push / Pull request",fillcolor="#DCEEE5"]; lint [label="Lint + unit tests"]; sast [label="SAST + dependency audit"]; build [label="Docker build"]; scan [label="Trivy CVE scan"]; gate [shape=diamond,label="All gates pass?",fillcolor="#FFF1D5"]; publish [label="Publish to GHCR\n(main push only)",fillcolor="#DCEEE5"]; stop [label="Block / investigate",fillcolor="#FCE3E3"]; start->lint->sast->build->scan->gate; gate->publish [label="Yes"]; gate->stop [label="No"]; }