digraph threat { graph [rankdir=TB,bgcolor="white",fontname="DejaVu Sans"]; node [shape=box,style="rounded,filled",fillcolor="#EEF3F8",color="#4D6A85",fontname="DejaVu Sans",fontsize=10]; code [label="Source repository\nspoofed contributor / malicious PR"]; ci [label="CI runner\nsecret exposure / workflow tampering"]; deps [label="Dependencies\npoisoned package / vulnerable library"]; registry [label="Container registry\nimage tampering / unauthorized push"]; code->ci [label="workflow execution"]; deps->ci [label="package install"]; ci->registry [label="image publish"]; guard1 [label="Branch protection + PR review",fillcolor="#E2F2E7"]; guard2 [label="Least-privilege token + masked secrets",fillcolor="#E2F2E7"]; guard3 [label="pip-audit + SAST + Trivy",fillcolor="#E2F2E7"]; guard4 [label="Digest / immutable tag + access control",fillcolor="#E2F2E7"]; code->guard1 [style=dashed,arrowhead=none]; ci->guard2 [style=dashed,arrowhead=none]; deps->guard3 [style=dashed,arrowhead=none]; registry->guard4 [style=dashed,arrowhead=none]; }